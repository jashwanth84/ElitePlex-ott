<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ElitePlex" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark</item>
        <item name="colorPrimary">@color/accent_gold</item>
        <item name="colorOnPrimary">@color/accent_gold_dark</item>
        <item name="colorSecondary">@color/accent_hot</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.ElitePlex.Fullscreen" parent="Theme.ElitePlex">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <style name="Theme.MyApplication" parent="Theme.ElitePlex" />
</resources>
